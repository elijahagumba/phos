#!/bin/sh
# Refuse a staged ADR or note number that another branch already gave to a different file.
# ADR 0292. Install with:
#   ln -sf ../../scripts/git-hooks/pre-commit .git/hooks/pre-commit
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
exec python3 scripts/check_number_allocation.py --staged
