# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Datasets are never committed. Each corpus is pinned by its committed manifest; see data/README.md.
data/*
!data/README.md
!data/manifest.example.json
!data/registry.json
!data/*/
data/*/*
!data/*/manifest.json
!data/*/topology.toml
!data/*/sentiel-manifest.json
# roles.toml is a hand-authored declaration of which signals are sensors, actuators and
# setpoints. It is not a dataset. Payloads stay ignored; the declaration is committed
# (docs/rules/data-tiers.md: never commit data files, roles.toml excepted).
!data/*/roles.toml
data/synth/

# Generated dataset-library payloads. The catalogues are committed.
dataset library/**/generated/

# OS
.DS_Store

# Local environment files
.env
.env.local
.env.*.local
